---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Send Josh" path="/404/">
  <section class="section">
    <div class="wrap" style="text-align:center; max-width:680px; padding-top:40px; padding-bottom:40px;">
      <p class="eyebrow">404</p>
      <h1>Page not found.</h1>
      <p>The page you're looking for isn't here. Try the <a href="/">home page</a>, or <a href="/contact/">contact Josh</a>.</p>
    </div>
  </section>
</Base>
